function [ra, rq, rv, rp, ry, rz, ktFEM, kfFEM] = estimateKfFEM(roughnessX, roughnessY, young, poisson, sigmaU, pressure, showplots)
%-------------------------------------------------------------------------
%                          estimateKfFEM function                    
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% FUNCTION DESCRIPTION:
% This function calculates main surface profile parameters (Ra, Rq, Rv, Rp, Ry, Rz)
% from 2D data points. It then estimates the notch radius using Quan et al.'s 
% proposal (DOI: 10.1016/j.ijfatigue.2021.106440) and computes the stress 
% concentration factor (Kt) using a static structural FEM analysis. 
% Finally, the fatigue limit corrector parameter (Kf) is estimated.
%
% INPUTS:
%   roughnessX - X coordinates of the surface profile [mm] (vector)
%   roughnessY - Y coordinates of the surface profile [mm] (vector)
%   young      - Young's modulus of the material [MPa]
%   poisson    - Poisson's ratio of the material
%   sigmaU     - Ultimate tensile strength (UTS) of the material [MPa]
%   pressure   - Applied pressure for the FEM simulation [MPa]
%   showPlots  - (Optional) Boolean flag to show/hide plots. Default is false.
%
% OUTPUTS:
%   ra, rq, rv, rp, ry, rz - Surface roughness parameters [microns]
%   ktFEM - Stress concentration factor estimated via FEM
%   kfFEM - Fatigue limit corrector parameter
%
%-------------------------------------------------------------------------
% Copyright (c) 2026, Diego Díaz Salamanca                       
% Contact: diazsdiego@uniovi.es                                      
%-------------------------------------------------------------------------
if nargin < 7
    showplots = 0; % 0 means false (no plots) by default
end

% ------------------------------------------------------------------------
% 1. Preliminary surface profile preparation
% ------------------------------------------------------------------------
% 1.1) Delete roughness profile tendency if exists
newYPoints = detrend(roughnessY, 1, "omitnan");
newYPoints = newYPoints.*1000; % Convert the roughness from mm to microns

% 1.2) Increase the number of points
samplingRateIncrease = 10;
newXPoints = linspace(0, max(roughnessX), length(roughnessX)*samplingRateIncrease);
newYPoints = spline(roughnessX, newYPoints, newXPoints);

% 1.3) Plot the profile
if showplots
    figure
    plot(newXPoints, newYPoints);
    xlabel('Length [mm]'); ylabel('Depth [\mum]');
end

% ------------------------------------------------------------------------
% 2. Computation of the main surface profile parameters
% ------------------------------------------------------------------------
% 2.1) Ra
ra = mean(abs(newYPoints(:)), 'omitnan');

% 2.2) Rq
rq = std(newYPoints(:), 'omitnan');

% 2.3) Rv
rv = abs(min(newYPoints(:), [], 'omitnan'));

% 2.4) Rp
rp = abs(max(newYPoints(:), [], 'omitnan'));

% 2.5) Ry 
ry = rv + rp;

% 2.6) Rz
[pSor, ~] = findpeaks(newYPoints, newXPoints, 'SortStr', 'descend');
[vSor, ~] = findpeaks(-newYPoints, newXPoints, 'SortStr', 'descend', 'MinPeakDistance', 0.1);
vSor = -vSor;
roughnessDepth = pSor(1:10) - vSor(1:10);
rz = mean(roughnessDepth);

% 2.7) Rsm
zeroLevel = zeros(size(newXPoints));
[xi, ~] = polyxpoly(newXPoints, newYPoints, newXPoints, zeroLevel);
if mod(length(xi), 2) ~= 0
    xi = xi(1:end-1);
end
sm = xi(3:2:end)-xi(1:2:end-2);
rsm = mean(sm)*1000;

% 2.8) Rmr
rmr = (sum(newYPoints>0)/length(newXPoints));

% ------------------------------------------------------------------------
% 3. Computation of the notch radius according to Quan et al.'s proposal
% ------------------------------------------------------------------------
h = rv;
l = rsm*(1 - rmr);
if h>l/2
    rho = (l/2);
else
    rho = (h/2) + ((l^2)/(8*h));
end

% ------------------------------------------------------------------------
% 4. Preparation of the signal for FEM analysis
% ------------------------------------------------------------------------
% 4.1) Generation of the 2D contour for the FEM analysis
newYPoints = newYPoints./1000; % The countour should be in mm!
y0 = min(newYPoints(1), newYPoints(end)) - 0.1;
yEnd = y0;
x0 = newXPoints(1);
xEnd = newXPoints(end);
contourY = [y0, newYPoints, yEnd, y0*ones(1, length(newXPoints)), y0];
contourX = [x0, newXPoints, xEnd, fliplr(newXPoints), x0];

% 4.2) Generation of mesh main points
dt = delaunayTriangulation(contourX', contourY');

% 4.3) Selection of mesh interior points
triangles = dt.ConnectivityList;
points = dt.Points;
centroids = (points(triangles(:, 1), :) + points(triangles(:, 2), :) + points(triangles(:, 3), :))/3;
in = inpolygon(centroids(:,1), centroids(:,2), contourX, contourY);
filteredTriangles = triangles(in, :);
tr = triangulation(filteredTriangles, points);
gm = fegeometry(tr); 

% 4.4) Final mesh generation
edgeIds = 1:gm.NumEdges;
hedgeValues = repmat({0.00025}, 1, gm.NumEdges);
hedgeSpec = reshape([num2cell(edgeIds); hedgeValues], 1, []);
gm = generateMesh(gm, "Hedge", hedgeSpec, "GeometricOrder", "quadratic");

% 4.5) Visualization
if showplots
    figure
    pdemesh(gm);
    figure
    pdegplot(gm, "EdgeLabels", "on");
end

% ------------------------------------------------------------------------
% 5. Kt estimation by means of the finite element method
% ------------------------------------------------------------------------
% 5.1) FEM model creation
model = femodel("AnalysisType", "structuralStatic", "Geometry", gm);
model.PlanarType = "planeStrain";
model.MaterialProperties = materialProperties(YoungsModulus = young, PoissonsRatio = poisson);

% 5.2) Definition of the model boundary conditions
mesh = model.Geometry.Mesh;
edgeFixed = nearestEdge(gm, [x0, y0/2]);
model.EdgeBC(edgeFixed) = edgeBC("Constraint", "fixed"); 

% 5.3) Definition of the model load case
edgeLoadId = nearestEdge(gm, [xEnd, y0/2]);
model.EdgeLoad(edgeLoadId) = edgeLoad("Pressure", pressure);

% 5.4) Model simulation
result = solve(model);

% 5.5) Post−processing of the mesh results to delete extreme values
nodesFiltered = findNodes(mesh, "box", [newXPoints(1) + 0.2, newXPoints(end) - 0.2], [-1.1*(rv/1000), 1.1*(rv/1000)]);

% 5.6) Extraction of results
maxStressSxx = max(result.Stress.sxx);
minStressSxx = min(result.Stress.sxx);
[maxStressSxxFiltered, idexMax] = max(result.Stress.sxx(nodesFiltered));

% 5.7) Kt estimation
ktFEM = maxStressSxxFiltered/abs(pressure);
nodeIdMax = nodesFiltered(idexMax);

% 5.8) Representation of results
if showplots
    figure
    pdeplot(mesh.Nodes, mesh.Elements,'XYData',result.Stress.sxx,'ColorMap','jet');
    hold on;
    xlabel(gca, 'Length [mm]', 'FontSize', 12); 
    ylabel(gca, 'Depth [mm]' , 'FontSize', 12);
    xlim([min(roughnessX), max(roughnessX)]);
    cb = colorbar;   
    ylabel (cb,'\sigma_{xx} [MPa]','FontSize',12);
    clim([floor(minStressSxx/10)*10 round(maxStressSxx/10)*10]);
    hold on
    plot(mesh.Nodes(1, nodeIdMax), mesh.Nodes(2, nodeIdMax), "or", "MarkerFaceColor", "g", "MarkerSize", 8);
end

% ------------------------------------------------------------------------
% 6. Kf parameter estimation 
% ------------------------------------------------------------------------
% 6.1) Material parameters
gamma = 0.025*(2070/sigmaU).^(1.8);
q = 1/(1+gamma/(rho/1000));

% 6.2) Kf computation
kfFEM = 1+q*(ktFEM - 1); 
end